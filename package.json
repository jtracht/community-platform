{
  "name": "community-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Modular community platform for transparent surveys, participatory decisions and owner-approved development.",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "tsx watch apps/server/src/main.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/apps/server/src/main.js",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "setup:admin": "tsx scripts/setup-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.6",
    "fastify": "^5.0.0",
    "mysql2": "^3.0.0",
    "otpauth": "^9.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
