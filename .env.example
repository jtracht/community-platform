NODE_ENV=development
HOST=127.0.0.1
PORT=3000
SITE_URL=http://localhost:3000
# Nur für die geprüfte öffentliche Produktionsdomain aktivieren, nicht im Staging.
SEARCH_INDEXING_ENABLED=false
DATABASE_URL=mysql://community:change-me@localhost:3306/community
DATABASE_TLS=false
DATABASE_TLS_CA=
SESSION_SECRET=replace-with-at-least-32-random-characters
GITHUB_REPOSITORY=jtracht/community-platform
# Optional, server-only. Fine-grained token limited to this repository's issues.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MAIL_DAILY_LIMIT=100
# Only verified proxy IPs/CIDRs, comma-separated; never set to true/all.
TRUSTED_PROXY=
# Vollständiger rechtlicher Betreiber, nicht nur der Projekt-/Markenname.
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
# Bearbeitbare Entwürfe für die Vorschau: docs/legal/README.md.
# Eigene endgültige Dateien vor dem Livegang ergänzen und freigeben.
# Entweder FILE oder TEXT je Dokument verwenden, nie beides zugleich.
LEGAL_IMPRINT_FILE=docs/legal/impressum.txt
LEGAL_PRIVACY_FILE=docs/legal/datenschutz.txt
LEGAL_CONTRIBUTION_FILE=docs/legal/beitraege.txt
LEGAL_IMPRINT_TEXT=
LEGAL_PRIVACY_TEXT=
LEGAL_CONTRIBUTION_TERMS=
# Produktion verweigert Entwurfsmarker und fehlende Pflichtangaben,
# auch wenn dieses Flag versehentlich auf true gestellt wird.
LEGAL_REVIEWED=false
# Set only after operator-approved retention policy (7..3650 days).
RAW_VOTE_RETENTION_DAYS=

# Stripe-Einrichtung: docs/STRIPE.md. Werte bleiben leer, bis dein Konto bereit ist.
# Bestehender Payment Link: optional, ersetzt NICHT die eingebettete Zahlung.
STRIPE_PAYMENT_LINK=

# Beide Schlüssel aus demselben Stripe-Testkonto/Sandbox verwenden.
# Publishable Key beginnt mit pk_test_, serverseitiger Secret Key mit sk_test_.
# Nur in deiner lokalen .env eintragen; keine echten Schlüssel hier oder im Git.
# Für Livebetrieb: pk_live_/sk_live_, NODE_ENV=production, HTTPS,
# vollständig konfigurierte Betreiberangaben und LEGAL_REVIEWED=true.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
